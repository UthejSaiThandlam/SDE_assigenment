# ==============================================================
# AuraPulse - Personalized Content Dashboard
# Environment Configuration Template
# ==============================================================
# Instructions:
# 1. Copy this file to .env.local
# 2. Add your API keys below
# 3. Configure these in your deployment project settings

# NewsAPI Key (Get free key from https://newsapi.org)
NEWS_API_KEY=

# Watchmode API Key (Get from https://api.watchmode.com)
WATCHMODE_API_KEY=

# Local Backend Proxy URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000