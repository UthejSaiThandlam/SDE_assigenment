# ==============================================================
# AuraPulse - Personalized Content Dashboard
# Environment Configuration Template
# ==============================================================
# Instructions:
# 1. Copy this file to .env.local
# 2. Add your API keys below (or leave blank to use the curated resilient fallback engine)
# 3. Configure these exact keys in your Vercel Project Settings for production deployment

# NewsAPI Key (Get free key from https://newsapi.org)
NEWS_API_KEY=

# Movie & Cinema API Key (Watchmode API from https://api.watchmode.com or TMDB)
MOVIE_API_KEY=
WATCHMODE_API_KEY=
TMDB_API_KEY=

# Local Backend Proxy URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000

